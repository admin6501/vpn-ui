+func (l *LeastPingStrategy) pickObservedOutbound(candidates []string, result *observatory.ObservationResult) string {
+	var selected string
+	var bestDelay int64
+	for _, status := range result.GetStatus() {
+		tag := status.GetOutboundTag()
+		if !status.GetAlive() || !slices.Contains(candidates, tag) {
+			continue
+		}
+		if len(l.failoverTags) > 0 {
+			if !slices.Contains(l.failoverTags, tag) {
+				continue
+			}
+			if tag == l.failoverTags[0] {
+				return tag
+			}
+		}
+		if selected == "" || status.GetDelay() < bestDelay {
+			selected, bestDelay = tag, status.GetDelay()
+		}
+	}
+	return selected
