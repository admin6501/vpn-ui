new file mode 100644
index 0000000..9c7881f
--- /dev/null
+++ b/proxy/hysteria/account/credential_regression_test.go
@@ -0,0 +1,25 @@
+package account
+
+import (
+	"github.com/xtls/xray-core/common/protocol"
+	"testing"
+)
+
+func TestDuplicateHysteriaCredentialCannotReplaceAccount(t *testing.T) {
+	v := NewValidator()
+	alice := &protocol.MemoryUser{Email: "alice", Account: &MemoryAccount{Auth: "same"}}
+	if err := v.Add(alice); err != nil {
+		t.Fatal(err)
+	}
+	if v.Add(&protocol.MemoryUser{Email: "bob", Account: &MemoryAccount{Auth: "same"}}) == nil {
+		t.Fatal("duplicate auth accepted")
+	}
+	if v.Get("same") != alice || v.GetByEmail("bob") != nil {
+		t.Fatal("failed addition changed ownership")
+	}
+	for _, u := range []*protocol.MemoryUser{nil, {Email: "empty", Account: &MemoryAccount{}}} {
+		if v.Add(u) == nil {
+			t.Fatal("invalid credential accepted")
+		}
+	}
+}
