+
+// A removed account must not open new streams or send more UDP datagrams on
+// an already authenticated QUIC connection.
+func (h *httpHandler) authorizedLocked() bool {
+	if !h.auth {
+		return false
+	}
+	if h.validator == nil {
+		return true
+	}
+	if h.user == nil {
+		return false
+	}
+	credential, ok := h.user.Account.(*account.MemoryAccount)
+	if !ok || credential == nil {
+		return false
+	}
+	return h.validator.Get(credential.Auth) == h.user
+}
+func (h *httpHandler) authorized() bool {
+	h.mutex.Lock()
+	defer h.mutex.Unlock()
+	return h.authorizedLocked()
+}
diff --git a/transport/internet/hysteria/auth_regression_test.go b/transport/internet/hysteria/auth_regression_test.go
new file mode 100644
index 0000000..911e541
--- /dev/null
+++ b/transport/internet/hysteria/auth_regression_test.go
@@ -0,0 +1,68 @@
+package hysteria
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/proxy/hysteria/account"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+)
+
+func TestManagedEmptyValidatorRejectsFallbackPassword(t *testing.T) {
+	h := &httpHandler{ctx: context.Background(), config: &Config{Auth: "fallback"}, quicParams: &internet.QuicParams{}, validator: account.NewValidator(), masqHandler: http.NotFoundHandler()}
+	r := httptest.NewRequest(http.MethodPost, "https://"+URLHost+URLPath, nil)
+	r.Header.Set(RequestHeaderAuth, "fallback")
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code == StatusAuthOK || h.auth {
+		t.Fatal("empty account list accepted shared password")
+	}
+}
+func TestRevokedHysteriaAccountCannotReuseQUICAuthorization(t *testing.T) {
+	v := account.NewValidator()
+	u := &protocol.MemoryUser{Email: "alice", Account: &account.MemoryAccount{Auth: "token"}}
+	if err := v.Add(u); err != nil {
+		t.Fatal(err)
+	}
+	h := &httpHandler{auth: true, user: u, validator: v}
+	if !h.authorized() {
+		t.Fatal("valid account rejected")
+	}
+	if err := v.Del("alice"); err != nil {
+		t.Fatal(err)
+	}
+	if h.authorized() {
+		t.Fatal("revoked account remains authorized")
+	}
+	called := false
+	m := &udpSessionManagerServer{authorized: h.authorized, addConn: func(stat.Connection) { called = true }}
+	m.feed(1, []byte("payload"))
+	if called {
+		t.Fatal("revoked datagram dispatched")
+	}
+}
+
+func TestHysteriaAuthAndStreamDispatcherAreSynchronized(t *testing.T) {
+	h := &httpHandler{}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 1000; i++ {
+			h.mutex.Lock()
+			h.auth = i%2 == 0
+			h.mutex.Unlock()
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 1000; i++ {
+			h.StreamDispatcher(0, nil, nil)
+		}
+	}()
+	wg.Wait()
+}
