+// Membership liveness is independent of byte counters: an idle connection remains
+// online until its context closes. Multiple streams share a reference-counted key.
+func trackMembershipOnline(ctx context.Context, sm stats.Manager, tag, email string) {
+	if tag == "" || email == "" {
+		return
+	}
+	key := base64.RawURLEncoding.EncodeToString([]byte(tag)) + "." + base64.RawURLEncoding.EncodeToString([]byte(email))
+	if om, _ := stats.GetOrRegisterOnlineMap(sm, "membership>>>online"); om != nil {
+		om.AddIP(key)
+		context.AfterFunc(ctx, func() { om.RemoveIP(key) })
+	}
+}
