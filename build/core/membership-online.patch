@@ -0,0 +1,49 @@
+package dispatcher
+
+import (
+	"context"
+	corestats "github.com/xtls/xray-core/app/stats"
+	"github.com/xtls/xray-core/features/stats"
+	"testing"
+	"time"
+)
+
+func TestMembershipOnlineReferenceCountsAndDisconnect(t *testing.T) {
+	sm, err := corestats.NewManager(context.Background(), &corestats.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, ca := context.WithCancel(context.Background())
+	defer ca()
+	b, cb := context.WithCancel(context.Background())
+	defer cb()
+	c, cc := context.WithCancel(context.Background())
+	defer cc()
+	trackMembershipOnline(a, sm, "naive-1", "same@example.com")
+	trackMembershipOnline(b, sm, "naive-1", "same@example.com")
+	trackMembershipOnline(c, sm, "tuic-2", "same@example.com")
+	om := sm.GetOnlineMap("membership>>>online")
+	if om == nil || om.Count() != 2 {
+		t.Fatal("multiple streams must count once per membership")
+	}
+	if len(sm.GetAllOnlineUsers()) != 0 {
+		t.Fatal("membership keys leaked into account online users")
+	}
+	ca()
+	// A second live stream on the same membership keeps the reference alive.
+	cb()
+	waitMembershipCount(t, om, 1)
+	cc()
+	waitMembershipCount(t, om, 0)
+}
+
+func waitMembershipCount(t *testing.T, om stats.OnlineMap, want int) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for om.Count() != want && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if om.Count() != want {
+		t.Fatalf("active memberships: got %d, want %d", om.Count(), want)
+	}
+}
