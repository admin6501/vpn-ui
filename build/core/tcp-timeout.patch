@@ -271,3 +272,15 @@ func setReusePort(fd uintptr) error {
 	}
 	return nil
 }
+
+// Unsupported optional timeouts must not abort mandatory TPROXY setup.
+func setTCPUserTimeout(fd, timeout int) error {
+	return tolerateUnsupportedTCPUserTimeout(syscall.SetsockoptInt(fd, syscall.IPPROTO_TCP, unix.TCP_USER_TIMEOUT, timeout))
+}
+func tolerateUnsupportedTCPUserTimeout(err error) error {
+	if stderrors.Is(err, syscall.ENOPROTOOPT) || stderrors.Is(err, syscall.EOPNOTSUPP) {
+		errors.LogWarning(context.Background(), "TCP_USER_TIMEOUT unavailable for this socket; retaining keepalive and TPROXY")
+		return nil
+	}
+	return err
+}
diff --git a/transport/internet/tcp_timeout_regression_test.go b/transport/internet/tcp_timeout_regression_test.go
new file mode 100644
index 0000000..d8c5929
--- /dev/null
+++ b/transport/internet/tcp_timeout_regression_test.go
@@ -0,0 +1,22 @@
+//go:build linux
+
+package internet
+
+import (
+	"fmt"
+	"syscall"
+	"testing"
+)
+
+func TestTCPUserTimeoutUnsupportedDoesNotAbortSocketSetup(t *testing.T) {
+	for _, err := range []error{nil, syscall.ENOPROTOOPT, syscall.EOPNOTSUPP, fmt.Errorf("socket: %w", syscall.ENOPROTOOPT)} {
+		if got := tolerateUnsupportedTCPUserTimeout(err); got != nil {
+			t.Fatalf("optional timeout aborted setup: %v", got)
+		}
+	}
+	for _, err := range []error{syscall.EPERM, syscall.EBADF, syscall.EINVAL} {
+		if got := tolerateUnsupportedTCPUserTimeout(err); got != err {
+			t.Fatalf("unexpected error suppressed: %v", err)
+		}
+	}
+}
