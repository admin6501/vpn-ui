+package command_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/app/stats"
+	. "github.com/xtls/xray-core/app/stats/command"
+)
+
+func TestUserTrafficIgnoresOtherCounterNamespaces(t *testing.T) {
+	sm, err := stats.NewManager(context.Background(), &stats.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	online, err := sm.RegisterOnlineMap("user>>>alice>>>online")
+	if err != nil {
+		t.Fatal(err)
+	}
+	online.AddIP("192.0.2.1")
+	account, err := sm.RegisterCounter("user>>>alice>>>traffic>>>uplink")
+	if err != nil {
+		t.Fatal(err)
+	}
+	account.Add(7)
+	other, err := sm.RegisterCounter("xxxxxxxalice>>>traffic>>>uplink")
+	if err != nil {
+		t.Fatal(err)
+	}
+	other.Add(99)
+	detail, err := sm.RegisterCounter("membership>>>dGFn.YWxpY2U>>>traffic>>>uplink")
+	if err != nil {
+		t.Fatal(err)
+	}
+	detail.Add(7)
+	response, err := NewStatsServer(sm).GetUsersStats(context.Background(), &GetUsersStatsRequest{IncludeTraffic: true, Reset_: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(response.Users) != 1 || response.Users[0].Traffic.Uplink != 7 {
+		t.Fatalf("wrong account stats: %+v", response)
+	}
+	if other.Value() != 99 || detail.Value() != 7 || account.Value() != 0 {
+		t.Fatal("account-only query consumed non-account counters")
+	}
+}
diff --git a/features/stats/registration_test.go b/features/stats/registration_test.go
new file mode 100644
--- /dev/null
+++ b/features/stats/registration_test.go
@@ -0,0 +1,103 @@
+package stats_test
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	corestats "github.com/xtls/xray-core/app/stats"
+	"github.com/xtls/xray-core/features/stats"
+)
+
+type simultaneousRegistration struct {
+	stats.Manager
+	ready   *sync.WaitGroup
+	release <-chan struct{}
+}
+
+func (m *simultaneousRegistration) GetCounter(name string) stats.Counter {
+	c := m.Manager.GetCounter(name)
+	if c == nil {
+		m.ready.Done()
+		<-m.release
+	}
+	return c
+}
+func (m *simultaneousRegistration) GetOnlineMap(name string) stats.OnlineMap {
+	c := m.Manager.GetOnlineMap(name)
+	if c == nil {
+		m.ready.Done()
+		<-m.release
+	}
+	return c
+}
+
+// Force every first lookup to see an absent counter. Only one registration can
+// win; the other connections must reuse it, rather than losing their meter.
+func TestConcurrentCounterRegistrationRetainsEveryConnection(t *testing.T) {
+	base, err := corestats.NewManager(context.Background(), &corestats.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	const connections = 32
+	var ready, done sync.WaitGroup
+	ready.Add(connections)
+	done.Add(connections)
+	release := make(chan struct{})
+	m := &simultaneousRegistration{Manager: base, ready: &ready, release: release}
+	for i := 0; i < connections; i++ {
+		go func() {
+			defer done.Done()
+			c, err := stats.GetOrRegisterCounter(m, "same")
+			if err != nil || c == nil {
+				t.Errorf("connection lost its counter: %v", err)
+				return
+			}
+			c.Add(7)
+		}()
+	}
+	ready.Wait()
+	close(release)
+	done.Wait()
+	if c := base.GetCounter("same"); c == nil || c.Value() != connections*7 {
+		t.Fatalf("missing concurrent usage: %v", c)
+	}
+}
+
+func TestConcurrentOnlineMapRegistrationRetainsEveryConnection(t *testing.T) {
+	base, err := corestats.NewManager(context.Background(), &corestats.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	const connections = 32
+	var ready, done sync.WaitGroup
+	ready.Add(connections)
+	done.Add(connections)
+	release := make(chan struct{})
+	m := &simultaneousRegistration{Manager: base, ready: &ready, release: release}
+	for i := 0; i < connections; i++ {
+		go func() {
+			defer done.Done()
+			c, err := stats.GetOrRegisterOnlineMap(m, "same")
+			if err != nil || c == nil {
+				t.Errorf("connection lost its online reference: %v", err)
+				return
+			}
+			c.AddIP("192.0.2.1")
+		}()
+	}
+	ready.Wait()
+	close(release)
+	done.Wait()
+	online := base.GetOnlineMap("same")
+	for i := 0; i < connections-1; i++ {
+		online.RemoveIP("192.0.2.1")
+	}
+	if online.Count() != 1 {
+		t.Fatal("live connection lost due to a registration race")
+	}
+	online.RemoveIP("192.0.2.1")
+	if online.Count() != 0 {
+		t.Fatal("stale online reference")
+	}
+}
