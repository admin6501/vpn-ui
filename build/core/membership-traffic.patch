diff --git a/app/dispatcher/membership_traffic.go b/app/dispatcher/membership_traffic.go
new file mode 100644
--- /dev/null
+++ b/app/dispatcher/membership_traffic.go
@@ -0,0 +1,34 @@
+package dispatcher
+
+import (
+	"encoding/base64"
+
+	"github.com/xtls/xray-core/features/stats"
+)
+
+// Keep the standard account counter for external API consumers, and meter the
+// same payload by source inbound. The panel uses the detailed counters alone
+// when present: adding the account counter again would charge every byte twice.
+// Register both before returning the link, so a QueryStats snapshot cannot see
+// a used account counter without its detailed counterpart.
+func withMembershipTrafficCounter(sm stats.Manager, account stats.Counter, tag, email, direction string) stats.Counter {
+	key := base64.RawURLEncoding.EncodeToString([]byte(tag)) + "." + base64.RawURLEncoding.EncodeToString([]byte(email))
+	member, _ := stats.GetOrRegisterCounter(sm, "membership>>>"+key+">>>traffic>>>"+direction)
+	if member == nil {
+		return account
+	}
+	if account == nil {
+		return member
+	}
+	return &membershipCounter{Counter: account, member: member}
+}
+
+type membershipCounter struct {
+	stats.Counter
+	member stats.Counter
+}
+
+func (c *membershipCounter) Add(value int64) int64 {
+	c.member.Add(value)
+	return c.Counter.Add(value)
+}
diff --git a/app/dispatcher/membership_traffic_test.go b/app/dispatcher/membership_traffic_test.go
new file mode 100644
--- /dev/null
+++ b/app/dispatcher/membership_traffic_test.go
@@ -0,0 +1,128 @@
+package dispatcher
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"sync"
+	"testing"
+
+	corestats "github.com/xtls/xray-core/app/stats"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/features/stats"
+	"github.com/xtls/xray-core/transport"
+)
+
+type membershipTestPolicy struct{ policy.DefaultManager }
+
+func (membershipTestPolicy) ForLevel(uint32) policy.Session {
+	p := policy.SessionDefault()
+	p.Stats.UserUplink = true
+	p.Stats.UserDownlink = true
+	return p
+}
+func detailName(tag, email, direction string) string {
+	enc := base64.RawURLEncoding.EncodeToString
+	return "membership>>>" + enc([]byte(tag)) + "." + enc([]byte(email)) + ">>>traffic>>>" + direction
+}
+func assertTrafficCounter(t *testing.T, sm stats.Manager, name string, want int64) {
+	t.Helper()
+	c := sm.GetCounter(name)
+	if c == nil || c.Value() != want {
+		t.Fatalf("counter %s = %v, want %d", name, c, want)
+	}
+}
+
+// Cover both dispatcher seams, including concurrent memberships of one account,
+// several streams on one membership, delimiter-containing and absent tags.
+func TestMembershipTrafficBothDispatcherLinks(t *testing.T) {
+	for _, wrapped := range []bool{false, true} {
+		t.Run(map[bool]string{false: "dispatch", true: "wrapped"}[wrapped], func(t *testing.T) {
+			sm, err := corestats.NewManager(context.Background(), &corestats.Config{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			const email = "same+user@example.com"
+			for _, tag := range []string{"vmess.1", "ss>>>2", "vmess.1", ""} {
+				ctx, cancel := context.WithCancel(context.Background())
+				t.Cleanup(cancel)
+				ctx = session.ContextWithInbound(ctx, &session.Inbound{Tag: tag, User: &protocol.MemoryUser{Email: email}})
+				if wrapped {
+					link := WrapLink(ctx, membershipTestPolicy{}, sm, &transport.Link{Reader: buf.NewReader(bytes.NewReader([]byte("upload"))), Writer: buf.Discard})
+					mb, err := link.Reader.ReadMultiBuffer()
+					if err != nil {
+						t.Fatal(err)
+					}
+					buf.ReleaseMulti(mb)
+					if err := link.Writer.WriteMultiBuffer(buf.MergeBytes(nil, []byte("reply"))); err != nil {
+						t.Fatal(err)
+					}
+				} else {
+					d := DefaultDispatcher{stats: sm, policy: membershipTestPolicy{}}
+					in, out := d.getLink(ctx)
+					if err := in.Writer.WriteMultiBuffer(buf.MergeBytes(nil, []byte("upload"))); err != nil {
+						t.Fatal(err)
+					}
+					mb, err := out.Reader.ReadMultiBuffer()
+					if err != nil {
+						t.Fatal(err)
+					}
+					buf.ReleaseMulti(mb)
+					if err := out.Writer.WriteMultiBuffer(buf.MergeBytes(nil, []byte("reply"))); err != nil {
+						t.Fatal(err)
+					}
+					mb, err = in.Reader.ReadMultiBuffer()
+					if err != nil {
+						t.Fatal(err)
+					}
+					buf.ReleaseMulti(mb)
+				}
+				cancel()
+			}
+			assertTrafficCounter(t, sm, "user>>>"+email+">>>traffic>>>uplink", 24)
+			assertTrafficCounter(t, sm, "user>>>"+email+">>>traffic>>>downlink", 20)
+			for tag, count := range map[string]int64{"vmess.1": 2, "ss>>>2": 1, "": 1} {
+				assertTrafficCounter(t, sm, detailName(tag, email, "uplink"), count*6)
+				assertTrafficCounter(t, sm, detailName(tag, email, "downlink"), count*5)
+			}
+		})
+	}
+}
+
+func TestMembershipTrafficConcurrentResetKeepsEveryByte(t *testing.T) {
+	sm, err := corestats.NewManager(context.Background(), &corestats.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	const email = "same"
+	const loops = 10000
+	account, _ := stats.GetOrRegisterCounter(sm, "user>>>"+email+">>>traffic>>>uplink")
+	counter := withMembershipTrafficCounter(sm, account, "vmess", email, "uplink")
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < loops; i++ {
+			counter.Add(7)
+		}
+		close(done)
+	}()
+	var total int64
+	for {
+		total += sm.GetCounter(detailName("vmess", email, "uplink")).Set(0)
+		select {
+		case <-done:
+			wg.Wait()
+			total += sm.GetCounter(detailName("vmess", email, "uplink")).Set(0)
+			if total != loops*7 {
+				t.Fatalf("lost/duplicated bytes during resets: %d", total)
+			}
+			return
+		default:
+		}
+	}
+}
