diff --git a/transport/internet/tls/ca_pin_regression_test.go b/transport/internet/tls/ca_pin_regression_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/tls/ca_pin_regression_test.go
@@ -0,0 +1,49 @@
+package tls
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol/tls/cert"
+)
+
+func TestPinnedCARequiresVerifiedPeerName(t *testing.T) {
+	caCert, caHash := cert.MustGenerate(nil, cert.Authority(true), cert.KeyUsage(x509.KeyUsageCertSign))
+	ca := common.Must2(x509.ParseCertificate(caCert.Certificate))
+	leafCert, _ := cert.MustGenerate(caCert, cert.DNSNames("expected.example"))
+	leaf := common.Must2(x509.ParseCertificate(leafCert.Certificate))
+	raw := [][]byte{leaf.Raw, ca.Raw}
+	for _, test := range []struct {
+		name, serverName string
+		byName           []string
+		allowed          bool
+	}{
+		{name: "no name"},
+		{name: "wrong name", serverName: "attacker.example"},
+		{name: "matching name", serverName: "expected.example", allowed: true},
+		{name: "explicit name override", serverName: "attacker.example", byName: []string{"expected.example"}, allowed: true},
+		{name: "wrong explicit override", serverName: "expected.example", byName: []string{"attacker.example"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			r := &RandCarrier{Config: &tls.Config{ServerName: test.serverName}, PinnedPeerCertSha256: [][]byte{caHash[:]}, VerifyPeerCertByName: test.byName}
+			if err := r.verifyPeerCert(raw, nil); (err == nil) != test.allowed {
+				t.Fatalf("allowed=%v, error=%v", test.allowed, err)
+			}
+		})
+	}
+	config := (&Config{PinnedPeerCertSha256: [][]byte{caHash[:]}}).GetTLSConfig(WithDestination(net.TCPDestination(net.DomainAddress("expected.example"), 443)))
+	if config.ServerName != "expected.example" {
+		t.Fatal("destination did not provide peer name", config.ServerName)
+	}
+	if err := config.VerifyPeerCertificate(raw, nil); err != nil {
+		t.Fatal("valid destination-pinned CA rejected", err)
+	}
+	foreignCA, _ := cert.MustGenerate(nil, cert.Authority(true), cert.KeyUsage(x509.KeyUsageCertSign))
+	foreignLeaf, _ := cert.MustGenerate(foreignCA, cert.DNSNames("expected.example"))
+	if err := config.VerifyPeerCertificate([][]byte{foreignLeaf.Certificate, ca.Raw}, nil); err == nil {
+		t.Fatal("pinned CA appended to an unrelated certificate chain was accepted")
+	}
+}
