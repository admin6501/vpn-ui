new file mode 100644
--- /dev/null
+++ b/transport/internet/hysteria/ca_pin_regression_test.go
@@ -0,0 +1,17 @@
+package hysteria
+
+import (
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet/tls"
+	"testing"
+)
+
+func TestHysteriaTLSDestinationPreservesHTTP3(t *testing.T) {
+	config := hysteriaTLSConfig(&tls.Config{}, tls.WithDestination(net.TCPDestination(net.DomainAddress("expected.example"), 443)))
+	if config.ServerName != "expected.example" {
+		t.Fatal("Hysteria omitted destination peer name", config.ServerName)
+	}
+	if len(config.NextProtos) != 1 || config.NextProtos[0] != "h3" {
+		t.Fatal("Hysteria lost HTTP/3 ALPN", config.NextProtos)
+	}
+}
